LLM_PROVIDER=agy
AGY_MODEL=gemini-3.6-flash-medium
AGY_TIMEOUT_SECONDS=300
AGY_MAX_RETRIES=2
MAX_PDF_SIZE_MB=25
MAX_TOTAL_UPLOAD_SIZE_MB=100
# 끝난 작업의 메모리 레코드를 걷어내기까지의 시간(분). 결과는 히스토리에 남으므로
# 걷어낸 뒤에도 같은 job_id로 조회·내려받기가 됩니다.
FORGE_JOB_RECORD_TTL_MINUTES=60

# 보고서·로그 저장 위치. 비우면 Forge 루트의 history/ · logs/ 를 씁니다.
# 컨테이너에서는 반드시 마운트된 볼륨 안을 가리켜야 합니다(docker-compose.yml 참고).
FORGE_HISTORY_DIR=
FORGE_LOG_DIR=

# CLI에 도구 권한을 열어 줍니다. 기본은 꺼짐(빈 값).
# 이 프롬프트에는 사용자가 올린 PDF 본문이 그대로 들어가므로, 켜면 문헌에 심긴 지시가
# 실행 권한을 얻을 수 있습니다. agy로 긴 프롬프트를 처리할 때 파일 읽기가 막혀
# 실패하는 경우에만 켜고, 신뢰할 수 있는 문헌에만 사용하십시오.
FORGE_CLI_ALLOW_TOOL_BYPASS=

# 구성대비 셀 하나를 몇 번 물어 다수결로 합칠지. 1이면 샘플링을 끕니다.
# 판정 안정성과 비용이 정비례합니다. judgment.json의 sample_agreement·sample_early_exit를
# 보고 정하십시오(만장일치 비율과 조기 종료 가능 셀 비율이 기록됩니다).
FORGE_COMPARE_SAMPLES=3
# 셀 단위 구성대비 동시 실행 수.
FORGE_COMPARE_WORKERS=4
# 인용발명 1건을 대비할 때 한 호출에 함께 실을 청구항 수. 1이면 종전과 같은 (청구항 × 문헌)
# 축이라 문헌 본문이 청구항 수만큼 반복 전송됩니다. 2 이상이면 문헌 축으로 묶어 그만큼 덜
# 보냅니다(10항 기준 실측 약 86% 절감). 다만 응답 하나에 담기는 판정이 늘어 셀이 빠질 위험이
# 커지고, 빠진 셀은 단건으로 폴백하므로 폴백이 잦으면 절감이 사라집니다. 회귀 확인 후 올리십시오.
FORGE_COMPARE_CLAIM_BATCH=1

# 청구항 분해를 이 파일로 고정합니다(claim_elements.json 형식). 실험용 통제 장치입니다.
# 분해는 매 실행 LLM이 새로 만들어 같은 청구항이 실행마다 다르게 쪼개지므로, 프롬프트 한 곳만
# 바꾼 효과를 재려면 분해를 붙들어야 합니다. 지정하면 분해 버전 검사를 건너뛰되 구성 원문
# 대조는 그대로 하며, 사용 사실이 보고서 validation에 남습니다.
FORGE_DECOMPOSITION_FILE=
# 분해 캐시를 무시하고 항상 다시 분해합니다. 분해 프롬프트를 손볼 때만 켜십시오.
FORGE_FORCE_REDECOMPOSE=

# 선행기술 검색 결과의 URL을 열어 문헌번호를 대조할 때의 건당 제한 시간(초). 0이면 대조 안 함.
FORGE_PRIOR_ART_VERIFY_TIMEOUT=15

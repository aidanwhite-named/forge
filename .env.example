LLM_PROVIDER=agy
AGY_MODEL=gemini-3.6-flash-medium
AGY_TIMEOUT_SECONDS=300
AGY_MAX_RETRIES=2
MAX_PDF_SIZE_MB=25
MAX_TOTAL_UPLOAD_SIZE_MB=100
# 끝난 작업의 메모리 레코드를 걷어내기까지의 시간(분). 결과는 히스토리에 남으므로
# 걷어낸 뒤에도 같은 job_id로 조회·내려받기가 됩니다.
FORGE_JOB_RECORD_TTL_MINUTES=60

# 보고서·로그 저장 위치. 비우면 Forge 루트의 history/ · logs/ 를 씁니다.
# 컨테이너에서는 반드시 마운트된 볼륨 안을 가리켜야 합니다(docker-compose.yml 참고).
FORGE_HISTORY_DIR=
FORGE_LOG_DIR=

# CLI에 도구 권한을 열어 줍니다. 기본은 꺼짐(빈 값).
# 이 프롬프트에는 사용자가 올린 PDF 본문이 그대로 들어가므로, 켜면 문헌에 심긴 지시가
# 실행 권한을 얻을 수 있습니다. agy로 긴 프롬프트를 처리할 때 파일 읽기가 막혀
# 실패하는 경우에만 켜고, 신뢰할 수 있는 문헌에만 사용하십시오.
FORGE_CLI_ALLOW_TOOL_BYPASS=
